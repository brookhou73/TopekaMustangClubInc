@model EmailQueue
@{
    ViewData["Title"] = "Contact Us";
}

<div class="container-fluid">
    <div class="card shadow border-0  mt-3">
        <div class="card-header ml-0 py-1">
            <div class="row mt-3 mb-5 text-center">
                <h3>@ViewData["Title"]</h3>
            </div>
            <div class="row">
                <div class="col">
                    <div class="row heading_color">
                        <h4>TOPEKA MUSTANG CLUB INC.</h4>
                    </div>

                    <p>
                        Topeka, Kansas<br />
                        <a href="mailto:topekamustangclubinc@gmail.com">topekamustangclubinc@gmail.com</a><br />
                    </p>
                </div>
            </div>
            <div class="mt-5 ">
                <div class="card-header bg-secondary bg-gradient ml-0 py-1">
                    <div class="row">
                        <div class="col-12 text-center">
                            <h2 class="text-white py-2">Send Us A Message</h2>
                        </div>
                    </div>
                </div>

                <div class="card-body p-2 ">
                    <form asp-controller="Home" asp-action="ContactUs" method="post">
                        <input asp-for="Id" hidden />
                        <input asp-for="Cc" hidden />
                        <input asp-for="Subject" hidden />
                        <div class="row">
                            <div class="form-floating p-1 col-12 mb-4">
                                <input asp-for="FullName" class="form-control border-0 shadow" />
                                <label class="pt-2 bg-transparent" style="height: 30px">What Is Your Name?</label>
                                <span class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="form-floating p-1 col-12 mb-4">
                                <input asp-for="Bcc" class="form-control border-0 shadow" />
                                <label class="pt-2 bg-transparent" style="height: 30px">What Is Your Email Address?</label>
                                <span class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="form-floating p-1 col-12 mb-4">
                                <input asp-for="Message" class="form-control border-0 shadow" />
                                <label class="pt-2 bg-transparent" style="height: 30px">How Can We Help You?</label>
                                <span class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row pt-2">
                            <div class="col-6 col-md-3">
                                <button type="submit" class="btn btn-primary form-control">Submit</button>
                                <div asp-validation-summary="All" class="text-danger"></div>
                            </div>
                            <div class="col-6 col-md-3">
                                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary border form-control">
                                    Go Back
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

</div>

@if (ViewBag.Message != null)
{
    <script type="text/javascript">
        window.onload = function () {
            alert("@ViewBag.Message");
        };
    </script>
}
