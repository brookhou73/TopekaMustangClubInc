@* @model List<CivitanEvents> *@

@{
    ViewData["Title"] = "Events Schedule";
}
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-91PQPSZMK8"></script>
<script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-91PQPSZMK8');
</script>
<div class="container-fluid">
    <div class="card shadow border-0  mt-3">
        <div class="card-header ml-0 py-1">
            <div class="container table-responsive">
                <div class="row mt-3 mb-5 text-center">
                    <h3>@ViewData["Title"]</h3>
                </div>
                <div class="row">
                    <div class="card-body p-0">
                        <p>
                            This calendar will get updated when events become available. Add this calendar to your device but some smaller devices will not show the entire calendar properly. If you are having trouble viewing this online calenar, try a more mobile device friendly preview of our calendar here:
                            <a target="_blank" href="https://calendar.google.com/calendar/embed?src=topekamustangclubinc%40gmail.com&ctz=America%2FChicago">Preview Public Calendar</a>
                        </p><br />
                        <iframe id="iFramCalendar" width="100%" height="100%" src="https://calendar.google.com/calendar/embed?src=topekamustangclubinc%40gmail.com&ctz=America%2FChicago" style="border: 0" frameborder="0" scrolling="no"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


