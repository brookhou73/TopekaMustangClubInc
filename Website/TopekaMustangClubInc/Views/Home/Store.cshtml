@* @model List<CivitanEvents> *@

@{
    ViewData["Title"] = "Topeka Mustang Club Store";
}

<div class="container-fluid">
    <div class="card shadow border-0 mt-3" style="height:1200px;">
        <div class="card-header" >
            <div class="row mt-1 mb-4 text-center">
                <h3>@ViewData["Title"]</h3>
            </div>
            <div>
                <p>
                    Welcome to the Topeka Mustang Club Inc. store. You can buy swagger and represent our club wherever you go.
                </p>
            </div>
            <div>
                <iframe src="https://www.storessimple.com/mm4u/tmci" title="TMCI Online Store" style="width: 100%; height:1000px;"></iframe>
            </div><br />
            <div>
                <p>
                    Are you having trouble with the online store? Please go <a href="https://www.storessimple.com/mm4u/tmci" target="_blank">here</a>.
                </p>
            </div>
        </div>
    </div>
</div>

